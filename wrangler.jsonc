{
  // Cloudflare Workers deploy: the only host. `npm run build` produces ./dist,
  // served as static assets. worker/index.ts adds the hourly Supabase
  // keep-alive (the cron below); it needs SUPABASE_URL and SUPABASE_ANON_KEY
  // as Worker secrets, which the deploy Action sets.
  "name": "wc26pickems",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve index.html for client-side routes (/leaderboard, /me, …).
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    // Hourly keep-alive, so Supabase's free tier never pauses the project.
    "crons": ["0 * * * *"]
  }
}
